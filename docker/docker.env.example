# ─────────────────────────────────────────────────────────────────────────────
# Cert Engine — Docker Compose environment
# Copy this file to  docker/.env  and fill in the values.
#
# These variables are read by docker-compose itself (NOT by the application)
# to provision the Mongo and Redis containers and to publish the service port.
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB root credentials. The application's MONGO_DATABASE_CONNECTION_STRING
# (in src/.env or in the Vault) must use these same credentials, plus ?authSource=admin.
MONGO_ROOT_USER="certengine"
MONGO_ROOT_PASSWORD=""

# Redis password. Must match REDIS_PASSWORD in src/.env when USE_VAULT="false".
REDIS_PASSWORD=""

# Optional — how the certengine port is published on the host.
# Default (if unset): 127.0.0.1:5001  → reachable only from the host's loopback.
#   - backend on another host in a private network:  CERTENGINE_BIND="10.0.0.5:5001"
#   - backend inside this Docker network: comment out the 'ports' block in compose
# Never bind on 0.0.0.0 if certengine is reachable from untrusted networks.
# CERTENGINE_BIND="127.0.0.1:5001"
