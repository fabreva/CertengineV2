# ─────────────────────────────────────────────────────────────────────────────
# Cert Engine — application environment
# Copy this file to  src/.env  and fill in the values.
#
# This template is for the STANDARD setup (USE_VAULT="false"), where every
# secret lives in this file. When USE_VAULT="true", the secret values are
# pulled from Infisical instead and must be left empty here (see README).
# ─────────────────────────────────────────────────────────────────────────────

# Secret source: "false" = read secrets from this file ; "true" = pull from Infisical Vault
USE_VAULT="false"

# ── Server ───────────────────────────────────────────────────────────────────
CERT_ENGINE_PORT="5001"
MAIN_SERVER_URL="http://localhost"

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV="dev"          # "dev" -> human-readable (pretty) logs ; "prod" -> JSON logs
LOG_LEVEL="info"        # fatal | error | warn | info | debug | trace | silent
PROJECT_NAME="certengine"

# ── Service authentication ───────────────────────────────────────────────────
# Shared secret the calling backend must send in the "X-API-Key" header.
# Generate one with:   openssl rand -hex 32
# The service refuses to start if this is empty.
SERVICE_API_KEY=""

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/certengine
# Docker: mongodb://<MONGO_ROOT_USER>:<MONGO_ROOT_PASSWORD>@mongo_certengine:27017/certengine?authSource=admin
MONGO_DATABASE_CONNECTION_STRING=""

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=""           # Local: 127.0.0.1   Docker: redis_certengine
REDIS_PORT="6379"
REDIS_PASSWORD=""       # On Docker, must match REDIS_PASSWORD in docker/.env

# ── Blockchain ───────────────────────────────────────────────────────────────
GAS="23000"
CONTRACT_GAS_CAP="1000000"          # ceiling for a contract call; does not replace GAS
MAX_SERIALIZE_BATCH="20"             # ERC-1155 constructor cap; used only at deploy
BLOCKCHAIN_URL=""                   # RPC endpoint, e.g. https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_NAME="Ethereum-Sepolia"  # or "Ethereum Mainnet"
CHAIN_ID="11155111"                 # Sepolia: 11155111   Mainnet: 1

# ── Gas oracles ──────────────────────────────────────────────────────────────
ETHERSCAN_KEY=""        # used when BLOCKCHAIN_NAME = "Ethereum Mainnet"
OWLRACLE_KEY=""         # used on Sepolia

# ── Ethereum wallet (the certifying account) ─────────────────────────────────
# SENDER_ADDR signs and owns the contracts. RECEIVER_ADDR receives raw
# transactions and the minted tokens. The two may be the same address.
SENDER_ADDR=""
SENDER_PRIVKEY=""       # must be funded with enough ETH to pay gas
RECEIVER_ADDR=""        # raw transaction target and token holder
ERC721_ADDR=""          # CertEngine721; owner must be SENDER_ADDR
ERC721_SBT_ADDR=""      # CertEngineSBT721; owner must be SENDER_ADDR
ERC1155_ADDR=""         # CertEngine1155; owner must be SENDER_ADDR

# ── Infisical Vault (only required when USE_VAULT="true") ────────────────────
VAULT_CLIENT_ID=""
VAULT_CLIENT_SECRET=""
VAULT_PROJECT_ID=""
